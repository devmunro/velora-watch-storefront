{
  "name": "velora",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "node scripts/patch-worker-config.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "admin:grant-owner": "node --env-file-if-exists=.env scripts/grant-owner.mjs",
    "predeploy": "pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@lucide/astro": "1.30.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "astro": "^7.2.0",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260804.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "sharp": "0.35.3",
    "supabase": "2.112.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
