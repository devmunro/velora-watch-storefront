{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "velora-storefront",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "fff8b75a08c14aa3aeb01543db7f7291"
    }
  ],
  "vars": {
    // Public configuration is safe to keep in source and is injected into local
    // development and every deployment. Private keys belong in Cloudflare Secrets.
    "PUBLIC_SUPABASE_URL": "https://axgmdldbwrspmwxeemvb.supabase.co",
    "PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_WJfgCa4Qgx72EldohC33Cw_NwYdmDRd",
    "PUBLIC_SITE_URL": "https://velora-storefront.highforce.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
