---
import type { CustomerAddress } from '../lib/server/account';

interface Props {
  address?: CustomerAddress | null;
  action: string;
  submitLabel: string;
}

const { address, action, submitLabel } = Astro.props;
---

<form class="account-card address-form" method="post" action={action}>
  <div class="form-grid">
    <div class="field">
      <label for="label">Address label</label>
      <input id="label" name="label" maxlength="40" value={address?.label ?? 'Home'} required />
    </div>
    <div class="field">
      <label for="recipient-name">Recipient name</label>
      <input id="recipient-name" name="recipientName" autocomplete="name" maxlength="120" value={address?.recipient_name ?? ''} required />
    </div>
    <div class="field field-wide">
      <label for="line-1">Address line 1</label>
      <input id="line-1" name="line1" autocomplete="address-line1" maxlength="120" value={address?.line_1 ?? ''} required />
    </div>
    <div class="field field-wide">
      <label for="line-2">Address line 2 <span>(optional)</span></label>
      <input id="line-2" name="line2" autocomplete="address-line2" maxlength="120" value={address?.line_2 ?? ''} />
    </div>
    <div class="field">
      <label for="city">Town or city</label>
      <input id="city" name="city" autocomplete="address-level2" maxlength="100" value={address?.city ?? ''} required />
    </div>
    <div class="field">
      <label for="county">County <span>(optional)</span></label>
      <input id="county" name="county" autocomplete="address-level1" maxlength="100" value={address?.county ?? ''} />
    </div>
    <div class="field">
      <label for="postcode">Postcode</label>
      <input id="postcode" name="postcode" autocomplete="postal-code" maxlength="10" value={address?.postcode ?? ''} required />
    </div>
    <div class="field">
      <label for="country">Country</label>
      <select id="country" name="countryCode" autocomplete="country" required>
        <option value="GB" selected={(address?.country_code ?? 'GB') === 'GB'}>United Kingdom</option>
      </select>
    </div>
    <label class="default-field field-wide">
      <input type="checkbox" name="isDefault" value="true" checked={address?.is_default ?? false} />
      <span>Use as my default delivery address</span>
    </label>
  </div>
  {address && <input type="hidden" name="version" value={address.version} />}
  <div class="form-actions">
    <button class="button button-primary" type="submit">{submitLabel}</button>
    <a class="button button-secondary" href="/account/addresses">Cancel</a>
  </div>
</form>

<style>
  .address-form {
    display: grid;
    gap: 1.75rem;
  }

  label span {
    color: var(--ink-dim);
    font-weight: 400;
    text-transform: none;
  }

  .default-field {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .default-field input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--champagne);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
</style>
