---
import { Award, RefreshCcw, ShieldCheck, Truck } from '@lucide/astro';

interface Props {
  benefits: Array<{ title: string; copy: string; icon: string }>;
}

const { benefits } = Astro.props;
const icons = { shield: ShieldCheck, delivery: Truck, truck: Truck, returns: RefreshCcw, refresh: RefreshCcw, quality: Award, award: Award };
---

<section class="benefit-strip" aria-label="Velora benefits">
  <div class="benefit-grid shell">
    {benefits.map((benefit) => {
      const Icon = icons[benefit.icon as keyof typeof icons] ?? Award;
      return (
        <article class="benefit">
          <Icon size={32} stroke-width={1.3} aria-hidden="true" />
          <div>
            <h2>{benefit.title}</h2>
            <p>{benefit.copy}</p>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .benefit-strip {
    border-block: 1px solid var(--line);
    background: #07090a;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: 1.8rem;
  }

  .benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    min-height: 3.2rem;
    padding-inline: 1.8rem;
    border-right: 1px solid var(--line);
  }

  .benefit:first-child {
    padding-left: 0;
  }

  .benefit:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .benefit :global(svg) {
    color: var(--champagne);
  }

  h2 {
    margin-bottom: 0.25rem;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  @media (max-width: 70rem) {
    .benefit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.5rem;
    }

    .benefit:nth-child(2) {
      padding-right: 0;
      border-right: 0;
    }

    .benefit:nth-child(3) {
      padding-left: 0;
    }
  }

  @media (max-width: 35rem) {
    .benefit-grid {
      grid-template-columns: 1fr;
    }

    .benefit,
    .benefit:first-child,
    .benefit:last-child,
    .benefit:nth-child(3) {
      padding: 0 0 1.25rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .benefit:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }
</style>
