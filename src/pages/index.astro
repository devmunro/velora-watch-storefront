---
import { ArrowRight } from '@lucide/astro';

import BenefitStrip from '../components/BenefitStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMoney } from '../data/catalog';
import { getPublicContent } from '../lib/server/content';

const content = await getPublicContent();
const featuredProducts = content.products.filter((product) => product.featured).slice(0, 3);
const journalPost = content.journalPosts[0];
---

<BaseLayout
  title="Velora"
  description="Discover Velora watches—timeless silhouettes, modern precision and considered materials for every moment."
>
  <section class="hero" aria-roledescription="carousel" aria-label="Featured Velora watches" data-hero>
    {content.heroSlides.map((slide, index) => (
      <article class="hero-slide" data-hero-slide={index} hidden={index !== 0}>
        <div class="hero-media" aria-hidden="true">
          <ResponsiveImage
            src={slide.image}
            alt=""
            width={index === 0 ? 1717 : 1254}
            height={index === 0 ? 916 : 1254}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
            sizes="100vw"
          />
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content shell">
          <div class="hero-copy">
            <p class="eyebrow">{slide.eyebrow}</p>
            <h1><span>{slide.title}</span> <em>{slide.accent}</em></h1>
            <p class="hero-description">{slide.copy}</p>
            <div class="hero-actions">
              <a class="button button-primary" href={slide.primaryHref}>{slide.primaryLabel}</a>
              {slide.secondaryHref && slide.secondaryLabel && (
                <a class="button button-secondary" href={slide.secondaryHref}>{slide.secondaryLabel}</a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
    <div class="hero-controls shell" aria-label="Choose featured watch">
      {content.heroSlides.map((slide, index) => (
        <button
          type="button"
          class:list={['hero-control', { active: index === 0 }]}
          data-hero-control={index}
          aria-label={`Show ${slide.title} ${slide.accent}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <i aria-hidden="true"></i>
        </button>
      ))}
    </div>
  </section>

  <BenefitStrip benefits={content.benefits} />

  <section class="section collections-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Our collections</p>
          <h2 class="section-title">Find the perfect watch<br />for your style.</h2>
        </div>
        <a class="text-link" href="/collections">View all collections <ArrowRight size={16} /></a>
      </div>
      <div class="grid grid-3">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="signature-section">
    <div class="signature-image">
      <ResponsiveImage
        src="/images/aster.webp"
        alt="Aster Automatic watch in silver steel"
        sizes="(max-width: 768px) 100vw, 50vw"
      />
    </div>
    <div class="signature-copy">
      <p class="eyebrow">The Velora standard</p>
      <h2 class="section-title">Precision you can feel.</h2>
      <p>
        Every Velora timepiece begins with proportion and purpose. From sapphire crystal to the final brushed surface,
        each detail is chosen to serve the watch for years to come.
      </p>
      <a class="button button-secondary" href="/about">Discover our approach</a>
    </div>
  </section>

  <section class="section featured-section section-muted">
    <div class="featured shell">
      <div class="featured-copy">
        <p class="eyebrow">An icon in black</p>
        <h2 class="section-title">Meridian<br /><em>Chronograph.</em></h2>
        <p>Defined by warm metallic details, deep contrast and timing controls made to be used.</p>
        <p class="featured-price">From {formatMoney(featuredProducts[0]?.variants[0]?.priceAmount ?? 49_500)}</p>
        <a class="button button-primary" href="/watches/meridian-chronograph">View Meridian</a>
      </div>
      <div class="featured-image card-image">
        <ResponsiveImage
          src="/images/meridian.webp"
          alt="Meridian Chronograph on a black leather strap"
          sizes="(max-width: 768px) 100vw, 55vw"
        />
      </div>
    </div>
  </section>

  {journalPost && (
    <section class="section journal-feature">
      <div class="shell journal-grid">
        <div class="journal-image card-image">
          <ResponsiveImage src={journalPost.image} alt={journalPost.imageAlt} sizes="(max-width: 768px) 100vw, 55vw" />
        </div>
        <div class="journal-copy">
          <p class="eyebrow">From the journal</p>
          <h2 class="section-title">{journalPost.title}</h2>
          <p>{journalPost.excerpt}</p>
          <a class="text-link" href={`/journal/${journalPost.slug}`}>Read the story <ArrowRight size={16} /></a>
        </div>
      </div>
    </section>
  )}

  <script>
    const slides = [...document.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const controls = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-control]')];

    function showSlide(index: number) {
      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== index;
      });
      controls.forEach((control, controlIndex) => {
        const active = controlIndex === index;
        control.classList.toggle('active', active);
        control.setAttribute('aria-pressed', String(active));
      });
    }

    controls.forEach((control, index) => control.addEventListener('click', () => showSlide(index)));
  </script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: clamp(35rem, 64vw, 47rem);
    overflow: hidden;
    background: #030506;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
  }

  .hero-slide[hidden] {
    display: none;
  }

  .hero-media,
  .hero-media :global(picture),
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .hero-slide:not(:first-child) .hero-media :global(img) {
    object-position: 72% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 5, 6, 0.99) 0%, rgba(3, 5, 6, 0.9) 24%, rgba(3, 5, 6, 0.3) 55%, rgba(3, 5, 6, 0.08) 100%),
      linear-gradient(0deg, rgba(3, 5, 6, 0.7), transparent 30%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: clamp(35rem, 64vw, 47rem);
    align-items: center;
    padding-bottom: 4rem;
  }

  .hero-copy {
    max-width: 31rem;
  }

  .hero-copy h1 {
    margin-bottom: 1.3rem;
    font-family: var(--font-serif);
    font-size: clamp(3.8rem, 6.3vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.86;
  }

  .hero-copy h1 span,
  .hero-copy h1 em {
    display: block;
  }

  .hero-copy h1 em,
  .featured-copy em {
    color: var(--champagne-pale);
    font-weight: 400;
  }

  .hero-description {
    max-width: 29rem;
    margin-bottom: 2rem;
    color: var(--ink-soft);
    font-size: clamp(0.98rem, 1.35vw, 1.1rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-controls {
    position: absolute;
    z-index: 5;
    right: 0;
    bottom: 1.5rem;
    left: 0;
    display: flex;
    justify-content: center;
    gap: 1.15rem;
    pointer-events: none;
  }

  .hero-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 0;
    background: transparent;
    color: var(--ink-dim);
    padding: 0.5rem 0;
    font-size: 0.7rem;
    pointer-events: auto;
  }

  .hero-control i {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  .hero-control.active {
    color: var(--ink);
  }

  .hero-control.active i {
    background: var(--ink);
  }

  .collections-section {
    background:
      radial-gradient(circle at 80% 30%, rgba(200, 164, 118, 0.05), transparent 30rem),
      var(--surface);
  }

  .signature-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 43rem;
    background: #0c0e0f;
  }

  .signature-image,
  .signature-image :global(picture),
  .signature-image :global(img) {
    width: 100%;
    height: 100%;
    min-height: 35rem;
  }

  .signature-image :global(img) {
    object-fit: cover;
  }

  .signature-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    max-width: 39rem;
    padding: clamp(3rem, 7vw, 7rem);
  }

  .signature-copy p:not(.eyebrow),
  .featured-copy > p:not(.eyebrow, .featured-price),
  .journal-copy > p:not(.eyebrow) {
    margin: 1.5rem 0 2rem;
    color: var(--ink-soft);
  }

  .featured {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .featured-copy {
    max-width: 27rem;
  }

  .featured-copy .section-title {
    font-size: clamp(3rem, 6vw, 5.75rem);
  }

  .featured-price {
    margin-bottom: 1.5rem;
    color: var(--champagne-pale);
  }

  .featured-image {
    aspect-ratio: 1.08;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .journal-image {
    aspect-ratio: 1.1;
  }

  .journal-copy {
    max-width: 30rem;
  }

  @media (max-width: 56rem) {
    .hero,
    .hero-content {
      min-height: 43rem;
    }

    .hero-media :global(img) {
      object-position: 65% center;
    }

    .hero-overlay {
      background:
        linear-gradient(90deg, rgba(3, 5, 6, 0.97), rgba(3, 5, 6, 0.58) 70%, rgba(3, 5, 6, 0.25)),
        linear-gradient(0deg, rgba(3, 5, 6, 0.8), transparent 45%);
    }

    .signature-section,
    .featured,
    .journal-grid {
      grid-template-columns: 1fr;
    }

    .signature-copy {
      max-width: none;
    }

    .featured-copy,
    .journal-copy {
      max-width: 40rem;
    }
  }

  @media (max-width: 40rem) {
    .hero,
    .hero-content {
      min-height: 45rem;
    }

    .hero-content {
      align-items: end;
      padding-bottom: 6rem;
    }

    .hero-media :global(img) {
      object-position: 67% top;
    }

    .hero-overlay {
      background: linear-gradient(0deg, #030506 5%, rgba(3, 5, 6, 0.92) 44%, rgba(3, 5, 6, 0.08) 82%);
    }

    .hero-copy h1 {
      font-size: clamp(3.35rem, 15vw, 4.8rem);
    }

    .hero-description {
      margin-bottom: 1.35rem;
    }

    .hero-actions .button {
      flex: 1;
      padding-inline: 1rem;
    }

    .hero-controls {
      justify-content: start;
    }

    .hero-control i {
      width: 1.25rem;
    }
  }
</style>
