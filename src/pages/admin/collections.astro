---
import { Plus } from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminCollections } from '../../lib/server/admin';
export const prerender = false;
const categories = await getAdminCollections();
const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Categories" description="Manage optional product categories." active="collections">
  <div class="admin-page-head"><div><p class="eyebrow">Optional organisation</p><h2>Categories</h2><p>Categories help customers browse similar watches. Products can remain uncategorised.</p></div></div>
  {saved && <p class="notice notice-success">Category saved.</p>}{error && <p class="notice notice-error">The category could not be saved.</p>}
  <aside class="relationship-note"><strong>Example</strong><span>Category: Chronographs</span><i>contains</i><span>Product: Meridian Chronograph</span></aside>
  <details class="admin-card create-panel"><summary><Plus size={16}/> New category</summary><form class="admin-form" method="post" action="/api/admin/collections"><div class="form-grid"><div class="field"><label>Name</label><input name="name" maxlength="100" required/></div><div class="field"><label>URL slug</label><input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required/></div><div class="field"><label>Small heading</label><input name="eyebrow" maxlength="100" required/></div><div class="field"><label>Position</label><input name="position" type="number" min="0" max="999" value={categories.length}/></div></div><div class="field"><label>Description</label><textarea name="description" maxlength="1000" required></textarea></div><div class="form-grid"><div class="field"><label>Image path</label><input name="imagePath" value="/images/meridian.webp" required/></div><div class="field"><label>Image description</label><input name="imageAlt" maxlength="240" required/></div><div class="field"><label>SEO title</label><input name="seoTitle" maxlength="70"/></div><div class="field"><label>SEO description</label><input name="seoDescription" maxlength="170"/></div></div><button class="button button-primary">Create draft</button></form></details>
  <div class="admin-grid">{categories.map((category:any)=><a class="admin-card-link" href={`/admin/collections/${category.id}`}><img src={category.image_path} alt="" loading="lazy"/><span class="admin-card-link-content"><span class:list={['status-pill',`status-${category.status}`]}>{category.status}</span><h3>{category.name}</h3><p>{category.eyebrow}</p><p>{category.description}</p></span></a>)}</div>
</AdminLayout>

<style>.notice,.relationship-note,.create-panel{margin-bottom:1rem}.relationship-note{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;border:1px solid rgba(200,164,118,.3);background:rgba(200,164,118,.04);padding:.9rem 1rem;font-size:.7rem}.relationship-note strong{color:var(--champagne-pale);text-transform:uppercase}.relationship-note span{border:1px solid var(--line);padding:.35rem .55rem;color:var(--ink)}.relationship-note i{color:var(--ink-dim)}.create-panel summary{display:flex;gap:.5rem;align-items:center;cursor:pointer;color:var(--champagne-pale);font-size:.75rem;text-transform:uppercase}.create-panel[open] summary{padding-bottom:1rem;margin-bottom:1rem;border-bottom:1px solid var(--line)}</style>
