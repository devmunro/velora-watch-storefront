---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminProductCreator } from '../../../lib/server/admin';
export const prerender=false;const data=await getAdminProductCreator();const error=Astro.url.searchParams.get('error');
---
<AdminLayout title="New product" description="Create a new Velora product." active="products"><div class="admin-page-head"><div><p class="eyebrow">Catalogue setup</p><h2>Add a product</h2><p>Create the product, its first purchasable SKU and opening stock together.</p></div><a class="button button-secondary" href="/admin/products">Back to products</a></div>{error&&<p class="notice notice-error">The product could not be created. Check for a duplicate slug or SKU.</p>}<form class="product-create" method="post" action="/api/admin/products"><div class="editor-main"><section class="admin-card admin-form"><p class="eyebrow">Product story</p><div class="form-grid"><div class="field"><label>Name</label><input name="name" maxlength="120" required/></div><div class="field"><label>URL slug</label><input name="slug" maxlength="140" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="meridian-chronograph" required/></div><div class="field"><label>Collection</label><select name="collectionId"><option value="">Unassigned</option>{data.collections.map((collection:any)=><option value={collection.id}>{collection.name}</option>)}</select></div><div class="field"><label>Storefront position</label><input name="position" type="number" min="0" max="999" value="0" required/></div></div><div class="field"><label>Card description</label><textarea name="shortDescription" maxlength="280" required></textarea></div><div class="field"><label>Full description</label><textarea name="description" class="long-copy" maxlength="4000" required></textarea></div><label class="check-field"><input type="checkbox" name="featured" value="true"/> Feature on the homepage</label></section><section class="admin-card admin-form"><p class="eyebrow">Specifications</p><div class="form-grid"><div class="field"><label>Case</label><input name="caseSpecification" placeholder="40 mm stainless steel"/></div><div class="field"><label>Movement</label><input name="movementSpecification" placeholder="Swiss quartz chronograph"/></div><div class="field"><label>Crystal</label><input name="crystalSpecification" placeholder="Double-domed sapphire"/></div><div class="field"><label>Water resistance</label><input name="waterResistanceSpecification" placeholder="10 ATM / 100 metres"/></div><div class="field"><label>Warranty</label><input name="warrantySpecification" value="Two years"/></div></div></section><section class="admin-card admin-form"><p class="eyebrow">Primary image</p><div class="form-grid"><div class="field"><label>Image path</label><input name="primaryImagePath" value="/images/meridian.webp" required/></div><div class="field"><label>Image description</label><input name="primaryImageAlt" maxlength="240" required/></div></div><div class="form-grid"><div class="field"><label>SEO title</label><input name="seoTitle" maxlength="70"/></div><div class="field"><label>SEO description</label><input name="seoDescription" maxlength="170"/></div></div></section></div><aside class="editor-aside"><section class="admin-card admin-form"><p class="eyebrow">First variant</p><div class="field"><label>Variant name</label><input name="variantName" placeholder="Black leather" required/></div><div class="field"><label>SKU</label><input name="sku" pattern="[A-Z0-9-]+" placeholder="MER-CHR-BLK" required/></div><div class="field"><label>Finish</label><input name="finish" placeholder="Black" required/></div><div class="field"><label>Strap</label><input name="strap" placeholder="Italian leather" required/></div><div class="field"><label>Price (GBP)</label><div class="money-input"><span>£</span><input name="pricePounds" inputmode="decimal" pattern="\d+(?:\.\d{1,2})?" placeholder="495.00" required/></div></div></section><section class="admin-card admin-form"><p class="eyebrow">Opening stock</p><div class="field"><label>Units on hand</label><input name="initialStock" type="number" min="0" max="100000" value="0" required/></div><div class="field"><label>Low-stock warning</label><input name="lowStockThreshold" type="number" min="0" max="1000" value="3" required/></div><p>The opening amount is recorded in the stock ledger.</p></section><button class="button button-primary save-button">Create product draft</button></aside></form></AdminLayout>
<style>.notice{margin-bottom:1rem}.product-create{display:grid;grid-template-columns:minmax(0,1fr) 21rem;align-items:start;gap:1rem}.editor-main,.editor-aside{display:grid;gap:1rem}.long-copy{min-height:12rem}.check-field{display:flex;align-items:center;gap:.6rem;color:var(--ink-soft);font-size:.75rem}.check-field input{width:auto}.money-input{display:flex;align-items:center;border:1px solid var(--line-strong);background:#060809}.money-input span{padding-left:.8rem;color:var(--champagne)}.money-input input{border:0;background:none}.editor-aside p{font-size:.7rem}.save-button{width:100%}@media(max-width:65rem){.product-create{grid-template-columns:1fr}}</style>
