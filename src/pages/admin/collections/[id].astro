---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminCollection } from '../../../lib/server/admin';
export const prerender = false;
const category = await getAdminCollection(Astro.params.id ?? '');
if (!category) return Astro.redirect('/admin/collections?error=not-found');
const role = Astro.locals.staffRole;
const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title={category.name} description="Edit a Velora product category." active="collections">
  <div class="admin-page-head"><div><p class="eyebrow">Category editor</p><h2>{category.name}</h2><p>Categories are optional and help customers browse related products.</p></div><div class="admin-actions"><a class="button button-secondary" href="/admin/collections">All categories</a>{role==='owner'&&<form method="post" action="/api/admin/publish"><input type="hidden" name="entity" value="collections"/><input type="hidden" name="id" value={category.id}/><input type="hidden" name="version" value={category.version}/><input type="hidden" name="status" value={category.status==='published'?'draft':'published'}/><input type="hidden" name="returnTo" value={`/admin/collections/${category.id}`}/><button class="button button-primary">{category.status==='published'?'Move to draft':'Publish category'}</button></form>}</div></div>
  {saved&&<p class="notice notice-success">Category saved.</p>}{error&&<p class="notice notice-error">The category could not be saved. Reload if it changed elsewhere.</p>}
  <div class="category-editor"><form class="admin-card admin-form" method="post" action={`/api/admin/collections/${category.id}`}><div class="form-grid"><div class="field"><label>Name</label><input name="name" value={category.name} required/></div><div class="field"><label>URL slug</label><input name="slug" value={category.slug} required/></div><div class="field"><label>Small heading</label><input name="eyebrow" value={category.eyebrow} required/></div><div class="field"><label>Storefront position</label><input name="position" type="number" min="0" max="999" value={category.position}/></div></div><div class="field"><label>Description</label><textarea name="description" maxlength="1000" required>{category.description}</textarea></div><div class="image-fields"><img src={category.image_path} alt=""/><div class="admin-form"><div class="field"><label>Image path</label><input name="imagePath" value={category.image_path} required/></div><div class="field"><label>Image description</label><input name="imageAlt" value={category.image_alt} required/></div></div></div><div class="form-grid"><div class="field"><label>SEO title</label><input name="seoTitle" value={category.seo_title??''}/></div><div class="field"><label>SEO description</label><input name="seoDescription" value={category.seo_description??''}/></div></div><input type="hidden" name="version" value={category.version}/><button class="button button-primary">Save category</button></form><aside class="admin-card"><p class="eyebrow">Products in this category</p><h2>{category.products?.length??0} products</h2><div class="product-list">{category.products?.map((product:any)=><a href={`/admin/products/${product.id}`}><span>{product.name}</span><span class:list={['status-pill',`status-${product.status}`]}>{product.status}</span></a>)}</div><p>Change a product’s category from its product editor.</p></aside></div>
</AdminLayout>

<style>.notice{margin-bottom:1rem}.category-editor{display:grid;grid-template-columns:minmax(0,1fr) 19rem;align-items:start;gap:1rem}.image-fields{display:grid;grid-template-columns:12rem 1fr;gap:1rem}.image-fields img{width:100%;aspect-ratio:1;object-fit:cover}.product-list{display:grid;margin:1rem 0;border-top:1px solid var(--line)}.product-list a{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.8rem 0;border-bottom:1px solid var(--line);font-size:.75rem}@media(max-width:65rem){.category-editor{grid-template-columns:1fr}}@media(max-width:38rem){.image-fields{grid-template-columns:1fr}}</style>
