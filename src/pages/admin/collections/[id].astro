---
import AdminLayout from '../../../layouts/AdminLayout.astro';import { getAdminCollection } from '../../../lib/server/admin';
export const prerender=false;const collection=await getAdminCollection(Astro.params.id??'');if(!collection)return Astro.redirect('/admin/collections?error=not-found');const role=Astro.locals.staffRole;const saved=Astro.url.searchParams.get('saved')==='1';const error=Astro.url.searchParams.get('error');
---
<AdminLayout title={collection.name} description="Edit a Velora collection." active="collections"><div class="admin-page-head"><div><p class="eyebrow">Collection editor</p><h2>{collection.name}</h2><p>Shape the collection story and review the watches it currently contains.</p></div><div class="admin-actions"><a class="button button-secondary" href="/admin/collections">All collections</a>{role==='owner'&&<form method="post" action="/api/admin/publish"><input type="hidden" name="entity" value="collections"/><input type="hidden" name="id" value={collection.id}/><input type="hidden" name="version" value={collection.version}/><input type="hidden" name="status" value={collection.status==='published'?'draft':'published'}/><input type="hidden" name="returnTo" value={`/admin/collections/${collection.id}`}/><button class="button button-primary">{collection.status==='published'?'Move to draft':'Publish collection'}</button></form>}</div></div>{saved&&<p class="notice notice-success">Collection saved.</p>}{error&&<p class="notice notice-error">The collection could not be saved. Reload if it changed elsewhere.</p>}<div class="collection-editor"><form class="admin-card admin-form" method="post" action={`/api/admin/collections/${collection.id}`}><div class="form-grid"><div class="field"><label>Name</label><input name="name" value={collection.name} required/></div><div class="field"><label>URL slug</label><input name="slug" value={collection.slug} required/></div><div class="field"><label>Small heading</label><input name="eyebrow" value={collection.eyebrow} required/></div><div class="field"><label>Storefront position</label><input name="position" type="number" min="0" max="999" value={collection.position}/></div></div><div class="field"><label>Description</label><textarea name="description" maxlength="1000" required>{collection.description}</textarea></div><div class="image-fields"><img src={collection.image_path} alt=""/><div class="admin-form"><div class="field"><label>Image path</label><input name="imagePath" value={collection.image_path} required/></div><div class="field"><label>Image description</label><input name="imageAlt" value={collection.image_alt} required/></div></div></div><div class="form-grid"><div class="field"><label>SEO title</label><input name="seoTitle" value={collection.seo_title??''}/></div><div class="field"><label>SEO description</label><input name="seoDescription" value={collection.seo_description??''}/></div></div><input type="hidden" name="version" value={collection.version}/><button class="button button-primary">Save collection</button></form><aside class="admin-card"><p class="eyebrow">Included watches</p><h2>{collection.products?.length??0} products</h2><div class="product-list">{collection.products?.map((product:any)=><a href={`/admin/products/${product.id}`}><span>{product.name}</span><span class:list={['status-pill',`status-${product.status}`]}>{product.status}</span></a>)}</div><p>Move a watch between collections from its product editor.</p></aside></div></AdminLayout>
<style>.notice{margin-bottom:1rem}.collection-editor{display:grid;grid-template-columns:minmax(0,1fr) 19rem;align-items:start;gap:1rem}.image-fields{display:grid;grid-template-columns:12rem 1fr;gap:1rem}.image-fields img{width:100%;aspect-ratio:1;object-fit:cover}.product-list{display:grid;margin:1rem 0;border-top:1px solid var(--line)}.product-list a{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.8rem 0;border-bottom:1px solid var(--line);font-size:.75rem}@media(max-width:65rem){.collection-editor{grid-template-columns:1fr}}@media(max-width:38rem){.image-fields{grid-template-columns:1fr}}</style>
