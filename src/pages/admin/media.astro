---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminMedia } from '../../lib/server/admin';

export const prerender = false;
const data = await getAdminMedia();
const role = Astro.locals.staffRole;
const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
const productName=(value:unknown)=>Array.isArray(value)?value[0]?.name:(value as any)?.name;
---

<AdminLayout title="Media" description="Stage and publish Velora catalogue media." active="media">
  <div class="admin-page-head"><div><p class="eyebrow">Image library</p><h2>Media workflow</h2><p>Upload JPEG, PNG or WebP images to private staging, require alternative text, then publish approved assets.</p></div></div>
  {saved && <p class="notice notice-success">Media updated.</p>}{error && <p class="notice notice-error">The media action could not be completed.</p>}
  <section class="admin-card upload-card"><p class="eyebrow">Private staging</p><h2>Upload image</h2>
    <form class="admin-form" data-media-upload><div class="form-grid"><div class="field"><label for="media-file">Image file</label><input id="media-file" name="file" type="file" accept="image/jpeg,image/png,image/webp" required/></div><div class="field"><label for="media-product">Related product (optional)</label><select id="media-product" name="productId"><option value="">Editorial / unassigned</option>{data.products.map((product:any)=><option value={product.id}>{product.name}</option>)}</select></div><div class="field field-wide"><label for="media-alt">Alternative text</label><input id="media-alt" name="altText" maxlength="240" required/></div></div><button class="button button-primary" type="submit">Upload to staging</button><p class="upload-message" data-upload-message aria-live="polite"></p></form>
  </section>

  <section class="media-section"><div class="section-title"><p class="eyebrow">Review queue</p><h2>Staged uploads</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>File</th><th>Product</th><th>Alternative text</th><th>Size</th><th>Status</th><th></th></tr></thead><tbody>
    {data.uploads.length ? data.uploads.map((upload:any)=><tr><td>{upload.original_filename}</td><td>{productName(upload.product) ?? 'Unassigned'}</td><td>{upload.alt_text}</td><td>{Math.ceil(upload.size_bytes/1024)} KB</td><td><span class:list={['status-pill',`status-${upload.status}`]}>{upload.status.replace('_',' ')}</span></td><td>{role==='owner'&&upload.status==='staged'?<form method="post" action={`/api/admin/media/${upload.id}/publish`}><input type="hidden" name="version" value={upload.version}/><button class="table-button" type="submit">Publish</button></form>:upload.catalogue_path??'—'}</td></tr>) : <tr><td colspan="6">No staged uploads.</td></tr>}
  </tbody></table></div></section>

  <section class="media-section"><div class="section-title media-title"><div><p class="eyebrow">Catalogue</p><h2>Product media</h2></div><label class="field"><span class="sr-only">Filter media</span><input type="search" placeholder="Filter media…" data-media-filter/></label></div><div class="catalogue-grid">
    {data.catalogueMedia.map((media:any)=><article class="admin-card catalogue-card" data-media-item={`${productName(media.product)} ${media.alt_text} ${media.status}`}><img class="media-preview" src={media.public_url} alt="" loading="lazy"/><div class="media-meta"><span class:list={['status-pill',`status-${media.status}`]}>{media.status}</span><p>{productName(media.product)}</p></div><form class="admin-form" method="post" action={`/api/admin/media/product/${media.id}`}><div class="field"><label>Alternative text</label><input name="altText" maxlength="240" value={media.alt_text} required/></div><div class="field"><label>Position</label><input name="position" type="number" min="0" max="999" value={media.position} required/></div><input type="hidden" name="version" value={media.version}/><button class="button button-secondary" type="submit">Save metadata</button></form>{role==='owner'&&<form class="publish-form" method="post" action="/api/admin/publish"><input type="hidden" name="entity" value="product_media"/><input type="hidden" name="id" value={media.id}/><input type="hidden" name="version" value={media.version}/><input type="hidden" name="status" value={media.status==='published'?'draft':'published'}/><input type="hidden" name="returnTo" value="/admin/media"/><button class="button button-secondary" type="submit">{media.status==='published'?'Move to draft':'Publish asset'}</button></form>}</article>)}
  </div></section>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const form=document.querySelector<HTMLFormElement>('[data-media-upload]');
    const message=document.querySelector<HTMLElement>('[data-upload-message]');
    form?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const fileInput=form.elements.namedItem('file') as HTMLInputElement;
      const file=fileInput.files?.[0];
      const altText=(form.elements.namedItem('altText') as HTMLInputElement).value;
      const productId=(form.elements.namedItem('productId') as unknown as HTMLSelectElement).value;
      if(!file)return;
      if(message)message.textContent='Authorising secure upload…';
      try{
        const signResponse=await fetch('/api/admin/media/sign-upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:file.name,mimeType:file.type,size:file.size,altText,productId})});
        const signed=await signResponse.json() as {uploadId?:string;path?:string;token?:string;supabaseUrl?:string;publishableKey?:string;error?:string};
        if(!signResponse.ok||!signed.path||!signed.token||!signed.supabaseUrl||!signed.publishableKey||!signed.uploadId)throw new Error(signed.error??'Upload could not be authorised.');
        if(message)message.textContent='Uploading to private staging…';
        const supabase=createClient(signed.supabaseUrl,signed.publishableKey,{auth:{persistSession:false,autoRefreshToken:false}});
        const {error:uploadError}=await supabase.storage.from('cms-staging').uploadToSignedUrl(signed.path,signed.token,file,{contentType:file.type});
        if(uploadError)throw uploadError;
        const complete=await fetch('/api/admin/media/complete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({uploadId:signed.uploadId})});
        if(!complete.ok)throw new Error('Upload verification failed.');
        window.location.assign('/admin/media?saved=1');
      }catch(error){if(message)message.textContent=error instanceof Error?error.message:'Upload failed.';}
    });
    const mediaFilter=document.querySelector<HTMLInputElement>('[data-media-filter]');
    const mediaItems=[...document.querySelectorAll<HTMLElement>('[data-media-item]')];
    mediaFilter?.addEventListener('input',()=>{const query=mediaFilter.value.toLowerCase();mediaItems.forEach(item=>item.hidden=!item.dataset.mediaItem?.toLowerCase().includes(query));});
  </script>
</AdminLayout>

<style>
  .notice{margin-bottom:1rem}.upload-card{max-width:58rem}.upload-card .eyebrow{margin-bottom:.25rem}.upload-card form{margin-top:1.25rem}.upload-message{min-height:1.2rem;margin:0;color:var(--champagne-pale);font-size:.7rem}.media-section{margin-top:3rem}.section-title{margin-bottom:1rem}.section-title .eyebrow{margin-bottom:.2rem}.section-title h2{margin:0;font-family:var(--font-serif);font-size:2.4rem;font-weight:400}.media-title{display:flex;align-items:end;justify-content:space-between;gap:1rem}.media-title .field{width:min(100%,20rem)}.table-button{border:0;border-bottom:1px solid var(--line-strong);background:transparent;padding:0;color:var(--champagne-pale);font-size:.7rem}.catalogue-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.catalogue-card{padding:0!important}.media-preview{width:100%;aspect-ratio:1.4;object-fit:cover}.media-meta,.catalogue-card form{margin:1rem}.media-meta{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.media-meta p{margin:0!important;color:var(--champagne)!important;font-size:.65rem}.publish-form{border-top:1px solid var(--line);padding-top:1rem}@media(max-width:70rem){.catalogue-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:55rem){.catalogue-grid{grid-template-columns:1fr}.media-title{align-items:start;flex-direction:column}}
</style>
