---
import { Boxes, FilePenLine, Package, ShoppingBag } from '@lucide/astro';

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminDashboard } from '../../lib/server/admin';

export const prerender = false;
let dashboard: Awaited<ReturnType<typeof getAdminDashboard>> | null = null;
try { dashboard = await getAdminDashboard(); } catch { dashboard = null; }
const role = Astro.locals.staffRole;
const denied = Astro.url.searchParams.get('access') === 'denied';
const cards = [
  { label: 'Products', value: dashboard?.productCount ?? '—', copy: `${dashboard?.draftCount ?? 0} draft`, href: '/admin/products', icon: Package, roles: ['owner', 'editor'] },
  { label: 'Low stock', value: dashboard?.lowStockCount ?? '—', copy: 'At or below warning level', href: '/admin/inventory', icon: Boxes, roles: ['owner', 'fulfilment'] },
  { label: 'Orders', value: dashboard?.orderCount ?? '—', copy: 'Across all statuses', href: '/admin/orders', icon: ShoppingBag, roles: ['owner', 'fulfilment'] },
  { label: 'Reservations', value: dashboard?.pendingReservationCount ?? '—', copy: 'Awaiting completion', href: '/admin/inventory', icon: FilePenLine, roles: ['owner', 'fulfilment'] },
];
---

<AdminLayout title="Dashboard" description="Velora administration dashboard." active="dashboard">
  <div class="admin-page-head">
    <div>
      <p class="eyebrow">Today at Velora</p>
      <h2>Store overview</h2>
      <p>Content, commerce and fulfilment signals for your current access level.</p>
    </div>
  </div>

  {!dashboard && <p class="notice notice-error" role="alert">Administrative data is temporarily unavailable.</p>}
  {denied && <p class="notice notice-error" role="alert">Your staff role does not permit access to that area.</p>}
  <div class="metric-grid">
    {cards.filter((card) => card.roles.includes(role ?? '')).map((card) => {
      const Icon = card.icon;
      return (
        <a class="admin-card metric-card" href={card.href}>
          <Icon size={22} stroke-width={1.4} />
          <div><strong>{card.value}</strong><span>{card.label}</span></div>
          <p>{card.copy}</p>
        </a>
      );
    })}
  </div>

  <section class="admin-card getting-started">
    <p class="eyebrow">Operational discipline</p>
    <h2>Publish with confidence.</h2>
    <p>
      Drafts remain private until an owner publishes them. Stock and order actions create immutable ledger or audit
      records, and stale forms are rejected before newer work can be overwritten.
    </p>
  </section>
</AdminLayout>

<style>
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .metric-card {
    display: grid;
    gap: 1rem;
  }

  .metric-card > :global(svg) {
    color: var(--champagne);
  }

  .metric-card div {
    display: grid;
  }

  .metric-card strong {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
  }

  .metric-card span {
    color: var(--ink-soft);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .metric-card p {
    font-size: 0.7rem;
  }

  .getting-started {
    max-width: 48rem;
    margin-top: 2.5rem;
  }

  .getting-started .eyebrow {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 72rem) {
    .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 38rem) {
    .metric-grid { grid-template-columns: 1fr; }
  }
</style>
