---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminContent } from '../../lib/server/admin';

export const prerender = false;
const content = await getAdminContent();
const role = Astro.locals.staffRole;
const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Homepage" description="Manage Velora homepage content and settings." active="content">
  <div class="admin-page-head">
    <div>
      <p class="eyebrow">Storefront content</p>
      <h2>Homepage and settings</h2>
      <p>Update public messaging while keeping publication controlled.</p>
    </div>
  </div>
  {saved && <p class="notice notice-success">Changes saved.</p>}
  {error === 'conflict' && <p class="notice notice-error">This content changed in another session. Reload before editing.</p>}
  {error && error !== 'conflict' && <p class="notice notice-error">Changes could not be saved.</p>}

  {role === 'owner' && (
    <section class="admin-card content-card">
      <div class="card-head"><div><p class="eyebrow">Global settings</p><h2>Store details</h2></div></div>
      <form class="admin-form" method="post" action="/api/admin/content/settings">
        <div class="form-grid">
          <div class="field field-wide"><label for="announcement">Announcement</label><input id="announcement" name="announcement" maxlength="160" value={content.settings.announcement} required /></div>
          <div class="field"><label for="threshold">Free shipping threshold (pence)</label><input id="threshold" name="freeShippingThreshold" type="number" min="0" max="1000000" value={content.settings.free_shipping_threshold} required /></div>
          <div class="field"><label for="contact-email">Contact email</label><input id="contact-email" name="contactEmail" type="email" maxlength="254" value={content.settings.contact_email ?? ''} /></div>
          <div class="field"><label for="seo-title">Default SEO title</label><input id="seo-title" name="defaultSeoTitle" maxlength="70" value={content.settings.default_seo_title} required /></div>
          <div class="field"><label for="seo-description">Default SEO description</label><input id="seo-description" name="defaultSeoDescription" maxlength="170" value={content.settings.default_seo_description} required /></div>
        </div>
        <input type="hidden" name="version" value={content.settings.version} />
        <button class="button button-primary" type="submit">Save settings</button>
      </form>
    </section>
  )}

  <section class="content-group">
    <div class="group-title"><p class="eyebrow">Hero carousel</p><h2>Slides</h2></div>
    {content.heroSlides.map((slide: any) => (
      <article class="admin-card content-card">
        <div class="card-head">
          <div><span class:list={['status-pill', `status-${slide.status}`]}>{slide.status}</span><h2>{slide.title} {slide.accent}</h2></div>
          {role === 'owner' && (
            <form method="post" action="/api/admin/publish">
              <input type="hidden" name="entity" value="hero_slides" /><input type="hidden" name="id" value={slide.id} />
              <input type="hidden" name="version" value={slide.version} /><input type="hidden" name="status" value={slide.status === 'published' ? 'draft' : 'published'} />
              <input type="hidden" name="returnTo" value="/admin/content" />
              <button class="button button-secondary" type="submit">{slide.status === 'published' ? 'Move to draft' : 'Publish'}</button>
            </form>
          )}
        </div>
        <form class="admin-form" method="post" action={`/api/admin/content/hero/${slide.id}`}>
          <div class="form-grid">
            <div class="field"><label>Eyebrow</label><input name="eyebrow" maxlength="100" value={slide.eyebrow} required /></div>
            <div class="field"><label>Heading</label><input name="title" maxlength="100" value={slide.title} required /></div>
            <div class="field"><label>Accent heading</label><input name="accent" maxlength="100" value={slide.accent} required /></div>
            <div class="field"><label>Position</label><input name="position" type="number" min="0" max="99" value={slide.position} required /></div>
            <div class="field field-wide"><label>Body</label><textarea name="body" maxlength="400" required>{slide.body}</textarea></div>
            <div class="field"><label>Primary label</label><input name="primaryLabel" maxlength="60" value={slide.primary_label} required /></div>
            <div class="field"><label>Primary path</label><input name="primaryHref" maxlength="200" value={slide.primary_href} required /></div>
            <div class="field"><label>Secondary label</label><input name="secondaryLabel" maxlength="60" value={slide.secondary_label ?? ''} /></div>
            <div class="field"><label>Secondary path</label><input name="secondaryHref" maxlength="200" value={slide.secondary_href ?? ''} /></div>
            <div class="field"><label>Media path</label><input name="mediaPath" maxlength="500" value={slide.media_path} required /></div>
            <div class="field"><label>Alternative text</label><input name="mediaAlt" maxlength="240" value={slide.media_alt} required /></div>
          </div>
          <input type="hidden" name="version" value={slide.version} />
          <button class="button button-primary" type="submit">Save slide</button>
        </form>
      </article>
    ))}
  </section>

  <section class="content-group">
    <div class="group-title"><p class="eyebrow">Primary navigation</p><h2>Navigation</h2></div>
    <div class="benefit-grid">
      {content.navigation.map((item: any) => (
        <article class="admin-card">
          <div class="card-head"><div><span class:list={['status-pill', `status-${item.status}`]}>{item.status}</span><h2>{item.label}</h2></div>
            {role === 'owner' && <form method="post" action="/api/admin/publish"><input type="hidden" name="entity" value="navigation_items"/><input type="hidden" name="id" value={item.id}/><input type="hidden" name="version" value={item.version}/><input type="hidden" name="status" value={item.status === 'published' ? 'draft' : 'published'}/><input type="hidden" name="returnTo" value="/admin/content"/><button class="button button-secondary" type="submit">{item.status === 'published' ? 'Unpublish' : 'Publish'}</button></form>}
          </div>
          <form class="admin-form" method="post" action={`/api/admin/content/navigation/${item.id}`}>
            <div class="form-grid"><div class="field"><label>Label</label><input name="label" maxlength="40" value={item.label} required/></div><div class="field"><label>Path</label><input name="href" maxlength="200" value={item.href} required/></div><div class="field"><label>Position</label><input name="position" type="number" min="0" max="999" value={item.position} required/></div></div>
            <input type="hidden" name="version" value={item.version}/><button class="button button-secondary" type="submit">Save navigation item</button>
          </form>
        </article>
      ))}
    </div>
  </section>

  <section class="content-group">
    <div class="group-title"><p class="eyebrow">Trust strip</p><h2>Benefits</h2></div>
    <div class="benefit-grid">
      {content.benefits.map((benefit: any) => (
        <form class="admin-card admin-form" method="post" action={`/api/admin/content/benefit/${benefit.id}`}>
          <div class="field"><label>Title</label><input name="title" maxlength="80" value={benefit.title} required /></div>
          <div class="field"><label>Body</label><input name="body" maxlength="140" value={benefit.body} required /></div>
          <div class="form-grid">
            <div class="field"><label>Icon</label><select name="icon"><option value="shield" selected={benefit.icon === 'shield'}>Shield</option><option value="delivery" selected={benefit.icon === 'delivery'}>Delivery</option><option value="returns" selected={benefit.icon === 'returns'}>Returns</option><option value="quality" selected={benefit.icon === 'quality'}>Quality</option></select></div>
            <div class="field"><label>Position</label><input name="position" type="number" min="0" max="99" value={benefit.position} required /></div>
          </div>
          <input type="hidden" name="version" value={benefit.version} />
          <button class="button button-secondary" type="submit">Save benefit</button>
        </form>
      ))}
    </div>
  </section>
</AdminLayout>

<style>
  .notice { margin-bottom: 1rem; }
  .content-card { margin-bottom: 1rem; }
  .card-head { display:flex;align-items:start;justify-content:space-between;gap:1rem;margin-bottom:1.5rem; }
  .card-head h2 { margin-top:.5rem; }
  .content-group { margin-top:3rem; }
  .group-title { margin-bottom:1rem; }
  .group-title .eyebrow { margin-bottom:.25rem; }
  .group-title h2 { margin:0;font-family:var(--font-serif);font-size:2.5rem;font-weight:400; }
  .benefit-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem; }
  @media(max-width:50rem){.benefit-grid{grid-template-columns:1fr}.card-head{flex-direction:column}}
</style>
