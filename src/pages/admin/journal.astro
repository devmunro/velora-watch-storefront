---
import { Plus } from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminJournal } from '../../lib/server/admin';

export const prerender = false;
const posts = await getAdminJournal();
const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
---
<AdminLayout title="Journal" description="Manage Velora journal articles." active="journal">
  <div class="admin-page-head"><div><p class="eyebrow">Editorial</p><h2>Journal articles</h2><p>Write helpful stories, group them by subject and connect readers to watches.</p></div><a class="button button-primary" href="/admin/journal/new"><Plus size={15}/> New article</a></div>
  {saved && <p class="notice notice-success">Journal changes saved.</p>}{error && <p class="notice notice-error">The article could not be saved.</p>}
  <div class="admin-toolbar"><p>{posts.length} articles</p><label class="field search-field"><span class="sr-only">Filter articles</span><input type="search" placeholder="Filter articles…" data-filter/></label></div>
  <div class="admin-grid" data-items>{posts.map((post:any)=><a class="admin-card-link" href={`/admin/journal/${post.id}`} data-item={`${post.title} ${post.slug} ${post.category?.name ?? ''}`}><img src={post.image_path} alt="" loading="lazy"/><span class="admin-card-link-content"><span class:list={['status-pill',`status-${post.status}`]}>{post.status}</span><h3>{post.title}</h3><p>{post.category?.name ?? 'Uncategorised'} · {post.reading_minutes} min read</p><p>{post.excerpt}</p></span></a>)}</div>
  {posts.length === 0 && <p class="admin-empty">No articles yet. Create the first Velora story.</p>}
  <script>const filter=document.querySelector<HTMLInputElement>('[data-filter]');const items=[...document.querySelectorAll<HTMLElement>('[data-item]')];filter?.addEventListener('input',()=>{const query=filter.value.toLowerCase();items.forEach(item=>item.hidden=!item.dataset.item?.toLowerCase().includes(query));});</script>
</AdminLayout>
<style>.notice{margin-bottom:1rem}.admin-toolbar>p{margin:0;color:var(--ink-soft);font-size:.75rem}.search-field{width:min(100%,20rem)}</style>
