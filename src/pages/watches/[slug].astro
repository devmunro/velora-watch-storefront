---
import { ArrowLeft, Check, Minus, Plus } from '@lucide/astro';

import BenefitStrip from '../../components/BenefitStrip.astro';
import ProductCard from '../../components/ProductCard.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { benefits as fallbackBenefits, formatMoney } from '../../data/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProduct, getPublishedProducts } from '../../lib/server/content';

const slug = Astro.params.slug ?? '';
const [product, allProducts] = await Promise.all([getPublishedProduct(slug), getPublishedProducts()]);
if (!product) return Astro.redirect('/404');

const related = allProducts.filter((entry) => entry.id !== product.id).slice(0, 2);
const initialVariant = product.variants[0];
---

<BaseLayout title={product.name} description={product.summary} image={product.image}>
  <div class="product-shell shell">
    <div class="product-gallery">
      <a class="back-link" href="/watches"><ArrowLeft size={16} /> All watches</a>
      <div class="product-image">
        <ResponsiveImage
          src={product.image}
          alt={product.imageAlt}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 900px) 100vw, 58vw"
        />
      </div>
    </div>
    <article class="product-details">
      <p class="eyebrow">{product.eyebrow}</p>
      <h1>{product.name}</h1>
      <p class="product-summary">{product.summary}</p>
      <p class="product-price" data-product-price>{initialVariant ? formatMoney(initialVariant.priceAmount) : 'Unavailable'}</p>

      {initialVariant ? (
        <form class="buy-form" data-buy-form>
          <fieldset>
            <legend>Choose a style</legend>
            <div class="variant-options">
              {product.variants.map((variant, index) => (
                <label class="variant-option">
                  <input
                    type="radio"
                    name="variant"
                    value={variant.id}
                    data-price={variant.priceAmount}
                    checked={index === 0}
                  />
                  <span>
                    <strong>{variant.name}</strong>
                    <small>{variant.finish} · {variant.strap}</small>
                  </span>
                  <em>{formatMoney(variant.priceAmount)}</em>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="quantity-row">
            <span class="field-label">Quantity</span>
            <div class="quantity-control">
              <button type="button" data-quantity-down aria-label="Reduce quantity"><Minus size={15} /></button>
              <output data-quantity>1</output>
              <button type="button" data-quantity-up aria-label="Increase quantity"><Plus size={15} /></button>
            </div>
          </div>

          <button class="button button-primary button-full" type="submit">Add to bag</button>
          <p class="stock-note"><Check size={16} /> Available for dispatch</p>
          <p class="add-message" data-add-message aria-live="polite"></p>
        </form>
      ) : (
        <p class="notice">This timepiece is currently unavailable.</p>
      )}

      <div class="delivery-notes">
        <p>Complimentary tracked UK delivery</p>
        <p>30-day returns on unworn watches</p>
        <p>Two-year Velora warranty</p>
      </div>
    </article>
  </div>

  <section class="product-story section section-muted">
    <div class="narrow">
      <p class="eyebrow">Designed in detail</p>
      <h2 class="section-title">{product.eyebrow}.</h2>
      <p>{product.description}</p>
      <dl>
        {product.specifications.map((specification) => (
          <div>
            <dt>{specification.label}</dt>
            <dd>{specification.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <BenefitStrip benefits={fallbackBenefits.map((benefit) => ({ ...benefit }))} />

  {related.length > 0 && (
    <section class="section">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Continue exploring</p>
            <h2 class="section-title">You may also like.</h2>
          </div>
        </div>
        <div class="related-grid">
          {related.map((entry) => <ProductCard product={entry} />)}
        </div>
      </div>
    </section>
  )}

  <script>
    import { addToCart } from '../../lib/cart';

    const form = document.querySelector<HTMLFormElement>('[data-buy-form]');
    const quantityOutput = document.querySelector<HTMLOutputElement>('[data-quantity]');
    const priceOutput = document.querySelector<HTMLElement>('[data-product-price]');
    const message = document.querySelector<HTMLElement>('[data-add-message]');
    let quantity = 1;

    function renderQuantity() {
      if (quantityOutput) quantityOutput.value = String(quantity);
    }

    document.querySelector('[data-quantity-down]')?.addEventListener('click', () => {
      quantity = Math.max(1, quantity - 1);
      renderQuantity();
    });

    document.querySelector('[data-quantity-up]')?.addEventListener('click', () => {
      quantity = Math.min(5, quantity + 1);
      renderQuantity();
    });

    form?.addEventListener('change', () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="variant"]:checked');
      const amount = Number(selected?.dataset.price ?? 0);
      if (priceOutput && amount) {
        priceOutput.textContent = new Intl.NumberFormat('en-GB', {
          style: 'currency',
          currency: 'GBP',
          maximumFractionDigits: 0,
        }).format(amount / 100);
      }
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const selected = form.querySelector<HTMLInputElement>('input[name="variant"]:checked');
      if (!selected) return;
      addToCart(selected.value, quantity);
      if (message) message.textContent = `${quantity} added to your bag. You can continue shopping or review your bag.`;
    });
  </script>
</BaseLayout>

<style>
  .product-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(23rem, 0.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2rem, 5vw, 4.5rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
    color: var(--ink-soft);
    font-size: 0.74rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .product-image {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-soft);
  }

  .product-image :global(picture),
  .product-image :global(img) {
    width: 100%;
    height: 100%;
  }

  .product-image :global(img) {
    object-fit: cover;
  }

  .product-details {
    position: sticky;
    top: 7.2rem;
    align-self: start;
    padding-top: 3rem;
  }

  .product-details h1 {
    margin-bottom: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 6vw, 5.6rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.9;
  }

  .product-summary {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .product-price {
    margin: 1.4rem 0 1.75rem;
    color: var(--champagne-pale);
    font-family: var(--font-serif);
    font-size: 2rem;
  }

  fieldset {
    margin: 0;
    border: 0;
    padding: 0;
  }

  legend {
    margin-bottom: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.095em;
    text-transform: uppercase;
  }

  .variant-options {
    display: grid;
    gap: 0.65rem;
  }

  .variant-option {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--line);
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    cursor: pointer;
  }

  .variant-option:has(input:checked) {
    border-color: var(--champagne);
    background: rgba(200, 164, 118, 0.045);
  }

  .variant-option input {
    position: absolute;
    left: 1rem;
    width: 0.85rem;
    height: 0.85rem;
    accent-color: var(--champagne);
  }

  .variant-option span {
    display: grid;
  }

  .variant-option strong {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .variant-option small {
    color: var(--ink-dim);
    font-size: 0.7rem;
  }

  .variant-option em {
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-style: normal;
  }

  .quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.25rem 0;
  }

  .quantity-control {
    display: grid;
    grid-template-columns: repeat(3, 2.35rem);
    align-items: center;
    border: 1px solid var(--line);
  }

  .quantity-control button,
  .quantity-control output {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 0;
    background: transparent;
  }

  .stock-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    color: var(--success);
    font-size: 0.72rem;
  }

  .add-message {
    min-height: 1.5rem;
    margin: 0.5rem 0 0;
    color: var(--champagne-pale);
    font-size: 0.75rem;
    text-align: center;
  }

  .delivery-notes {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .delivery-notes p {
    margin: 0;
  }

  .product-story {
    text-align: center;
  }

  .product-story .section-title {
    margin-bottom: 1.5rem;
  }

  .product-story > div > p:not(.eyebrow) {
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  dl {
    margin: 3rem 0 0;
    border-top: 1px solid var(--line);
    text-align: left;
  }

  dl div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.9rem 0;
  }

  dt {
    color: var(--ink-dim);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--ink-soft);
    text-align: right;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 58rem) {
    .product-shell {
      grid-template-columns: 1fr;
    }

    .product-details {
      position: static;
      padding-top: 0;
    }
  }

  @media (max-width: 40rem) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
