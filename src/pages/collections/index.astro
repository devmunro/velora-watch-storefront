---
import { ArrowRight } from '@lucide/astro';

import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCollections } from '../../lib/server/content';

const collections = await getPublishedCollections();
---

<BaseLayout
  title="Collections"
  description="Explore Velora Atelier, Heritage and Voyager—three watch collections shaped around how time is lived."
>
  <header class="page-intro">
    <div class="shell">
      <p class="eyebrow">Velora collections</p>
      <h1 class="page-title">Three expressions of time.</h1>
      <p class="section-copy">From measured performance to quiet refinement and purposeful travel.</p>
    </div>
  </header>
  <section class="collection-list shell">
    {collections.map((collection, index) => (
      <article class="collection-row">
        <a class="collection-image card-image" href={`/collections/${collection.slug}`}>
          <ResponsiveImage src={collection.image} alt={collection.imageAlt} sizes="(max-width: 768px) 100vw, 55vw" />
        </a>
        <div class="collection-copy">
          <p class="eyebrow">Collection {String(index + 1).padStart(2, '0')}</p>
          <h2>{collection.name}</h2>
          <p>{collection.summary}</p>
          <a class="text-link" href={`/collections/${collection.slug}`}>
            Explore {collection.name} <ArrowRight size={16} />
          </a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .collection-list {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .collection-row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(2.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .collection-row:first-child {
    padding-top: 0;
  }

  .collection-row:nth-child(even) .collection-image {
    order: 2;
  }

  .collection-image {
    aspect-ratio: 1.18;
  }

  .collection-image :global(picture),
  .collection-image :global(img) {
    width: 100%;
    height: 100%;
  }

  .collection-image :global(img) {
    object-fit: cover;
  }

  .collection-copy {
    max-width: 31rem;
  }

  .collection-copy h2 {
    margin-bottom: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .collection-copy > p:not(.eyebrow) {
    margin-bottom: 1.75rem;
    color: var(--ink-soft);
  }

  @media (max-width: 52rem) {
    .collection-row {
      grid-template-columns: 1fr;
    }

    .collection-row:nth-child(even) .collection-image {
      order: initial;
    }
  }
</style>
