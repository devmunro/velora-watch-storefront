---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1>Time took a different turn.</h1>
    <p>The page you were looking for is no longer here, or the address may have changed.</p>
    <a class="button button-primary" href="/">Return home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 65vh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  h1 {
    max-width: 12ch;
    margin-bottom: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.9;
  }

  .not-found > p:not(.eyebrow) {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: var(--ink-soft);
  }
</style>
